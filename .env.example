# =====================================================================
# 觅影 portal 环境变量示例
# 复制为 .env（或在 docker-compose.yml 中直接填），替换全部 change-me 值。
# .env 已被 .gitignore 排除，切勿提交真实值。
# =====================================================================

# ---- 上游 PanSou 容器地址（同一 docker 网络内）----
PANSOU_UPSTREAM=http://pansou

# ---- SQLite 数据库路径（容器内，已挂载到宿主机）----
DB_PATH=/app/data/portal.db

# ---- 管理员用户名 ----
ADMIN_USER=admin

# ---- 账号清单：user:pass，逗号分隔；增删账号改这一行 ----
AUTH_USERS=admin:change-me-admin-password,user2:change-me-user-password

# ---- JWT 长效令牌密钥：openssl rand -hex 32 生成，至少 32 位 ----
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
TOKEN_TTL_DAYS=180

# ---- Bark 滥用告警（iOS，可留空）----
BARK_KEY=

# ---- 海报图床回源代理（Telegram CDN 被墙时用，可留空）----
# 形如 http://user:pass@host:port
POSTER_PROXY=
POSTER_CACHE_DIR=/app/data/imgcache
POSTER_CACHE_TTL=2592000

# ---- 滥用限流告警阈值 ----
RATE_WINDOW_SEC=600
RATE_WINDOW_MAX=60
RATE_DAY_MAX=500
ALERT_COOLDOWN_SEC=900
EVENT_KEEP_DAYS=30

# ---- 登录防爆破 ----
LOGIN_WINDOW_SEC=900
LOGIN_MAX_FAIL=8
LOGIN_LOCK_SEC=900
# 失败达到该次数先 Bark 预警一次（0 关闭，需小于 LOGIN_MAX_FAIL）；新公网 IP 登录是否提醒
LOGIN_WARN_FAIL=3
LOGIN_IP_NOTIFY=1

# ---- 失效链接检测 ----
# 同步验证窗口：每类网盘先保底，再全局补足到 VERIFY_N
VERIFY_N=40
VERIFY_WORKERS=16
VERIFY_CACHE_TTL=1800
VERIFY_TIMEOUT=3
# A：每个网盘类型保底验证条数；B：后台全量净化单次安全上限
VERIFY_PER_TYPE=8
VERIFY_BG_LIMIT=160
# C：同版本指纹去重开关；来源健康度降权最小样本与系数下限
DEDUP_ENABLED=1
SOURCE_HEALTH_MIN=10
SOURCE_HEALTH_FLOOR=0.5

# ---- 方案一：查询改写 / 多路召回 ----
# 主词去重后唯一链接数低于 QUERY_REWRITE_MIN_HITS 时，按季等价、逐级退化生成变体补召回，
# 经根片名/异季/年份相关性过滤防串片；只作用于回源分支，本地 FTS 命中不触发。
QUERY_REWRITE_ENABLED=1
QUERY_VARIANT_MAX=5
QUERY_REWRITE_MIN_HITS=8
QUERY_VARIANT_TIMEOUT=8
# 同义词召回：繁简体 + 作品别号/中英译名（纯规则词典、零依赖），等价根词仍过季/年防串片闸门
SYNONYM_ENABLED=1
SYNONYM_ALIAS_MAX=2
# 远程 MCP（Streamable HTTP / JSON-RPC 2.0）：POST /portal/mcp，Bearer JWT 鉴权
MCP_ENABLED=1
MCP_RESULT_LIMIT=30

# ---- 混合 FTS5 预索引（搜索先查本地，未命中再回源 PanSou，后台异步回填）----
# 只调用 PanSou 自己的搜索接口，不连 Telegram、不申请 api_id/api_hash、无封号风险。
FTS_ENABLED=1
FTS_FILL_INTERVAL=21600
FTS_JOB_TTL=21600
FTS_STARTUP_DELAY=120
FTS_MIN_HITS=8
FTS_MAX_WORDS=30
FTS_MAX_ARTS_PER_WORD=60
FTS_ART_TTL=3888000
FTS_QUERY_LIMIT=80

# ---- 日志与 SQLite 自动备份 ----
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 启动先备份一份，之后每隔 BACKUP_INTERVAL_SEC 做在线一致性备份，目录仅留最新 BACKUP_KEEP 份
BACKUP_ENABLED=1
BACKUP_DIR=/app/data/backups
BACKUP_KEEP=7
BACKUP_INTERVAL_SEC=86400

# ---- 版本 / 上游熔断 / 异常链接自动重试（均有内置默认值，可整段省略）----
# 后台「系统可观测」面板与 /portal/health 展示的版本号
APP_VERSION=0.5.0
# 上游连续失败 CB_FAIL_THRESHOLD 次即熔断，熔断期快速失败并优先用本地 FTS 兜底，
# 冷却 CB_OPEN_SEC 秒后放行一次试探，成功闭合、失败重新打开
CB_FAIL_THRESHOLD=5
CB_OPEN_SEC=30
# 请求异常的链接不再直接判活，先记 unknown 由后台重试：每隔 VERIFY_RETRY_INTERVAL_SEC 秒一次，
# 最多 VERIFY_RETRY_MAX 次仍异常才容错放行；扫描周期/启动延迟/并发上限如下
VERIFY_RETRY_MAX=3
VERIFY_RETRY_INTERVAL_SEC=180
VERIFY_RETRY_SCAN_SEC=60
VERIFY_RETRY_START_DELAY=120
VERIFY_RETRY_WORKERS=4

# ---- 关键词 RSS 订阅（标准库手拼 RSS 2.0，零新增依赖；均有内置默认值，可整段省略）----
# 同一 token+关键词的 feed 内存缓存秒数；单条 feed 最多输出条数；聚合 feed 最多跟踪的“在看”关键词数
RSS_CACHE_SEC=60
RSS_MAX_ITEMS=30
RSS_FEED_KEYWORDS_MAX=5
